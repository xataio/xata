{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "profile",
    "metadata",
    "credentials"
  ],
  "properties": {
    "plugins": {
      "type": "object",
      "properties": {
        "scaleToZeroReplicas": {"type": "integer", "minimum": 1}
      }
    },
    "profile": {
      "enum": [
        "single-node",
        "multi-node"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        }
      }
    }
  }
}
